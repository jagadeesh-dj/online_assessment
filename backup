import subprocess
import os
from pathlib import Path
from bs4 import BeautifulSoup
import json


def run_all_tests_and_generate_reports():
    """Run all pytest tests once, then split the master HTML report into per-test-case reports."""
    reports_dir = "reports"
    os.makedirs(reports_dir, exist_ok=True)

    master_report = os.path.join(reports_dir, "master_report.html")

    # Run all tests at once
    print("Running full pytest suite...")
    subprocess.run(
        [
            "pytest",
            "powerbi_test_framework/tests",
            "-v",
            "-s",
            f"--html={master_report}",
            "--self-contained-html"
        ],
        check=False,
    )

    print(f"✅ Master report generated: {master_report}")

    print("Parsing master report and splitting by test case...")
    with open(master_report, "r", encoding="utf-8") as f:
        content = f.read()
        soup = BeautifulSoup(content, "html.parser")

    # Find the data container with JSON blob
    data_container = soup.find("div", id="data-container")

    if not data_container or not data_container.get("data-jsonblob"):
        print("❌ Error: Could not find data-jsonblob in the HTML")
        return

    # Parse the JSON data
    json_data = json.loads(data_container["data-jsonblob"])

    if "tests" not in json_data:
        print("❌ Error: No tests found in JSON data")
        return

    test_count = sum(len(tests) for tests in json_data["tests"].values())
    print(f"Found {test_count} test cases in master report")

    # Process each test
    for test_path, test_details_list in json_data["tests"].items():
        for test_detail in test_details_list:
            test_name = test_detail.get("testId")
            if not test_name:
                continue

            # Create safe filename
            test_name_safe = test_name.split("::")[-1].strip()

            # Create a copy of the original HTML
            new_soup = BeautifulSoup(content, "html.parser")

            # Find and update the data container
            new_data_container = new_soup.find("div", id="data-container")

            # Create new JSON data with only this test
            new_json_data = {
                "environment": json_data.get("environment", {}),
                "tests": {test_path: [test_detail]},
                "renderCollapsed": json_data.get("renderCollapsed", []),
                "initialSort": json_data.get("initialSort", "result"),
                "title": f"{test_name_safe}_report.html"
            }

            # Update the data-jsonblob attribute
            new_data_container["data-jsonblob"] = json.dumps(new_json_data, separators=(',', ':'))

            # Save individual report
            report_path = os.path.join(reports_dir, f"{test_name_safe}_report.html")
            with open(report_path, "w", encoding="utf-8") as f:
                f.write(str(new_soup))

            print(f"🧪 Generated: {report_path}")

    print(f"\n✅ Done! Individual HTML reports generated in '{reports_dir}'")


if __name__ == "__main__":
    run_all_tests_and_generate_reports()



